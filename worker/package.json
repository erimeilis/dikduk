{
  "name": "worker",
  "version": "1.0.0",
  "description": "DikDuk Cloudflare Worker: Hebrew dictionary lookup (Pealim) and grammar analysis API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erimeilis/dikduk.git",
    "directory": "worker"
  },
  "homepage": "https://github.com/erimeilis/dikduk#readme",
  "bugs": {
    "url": "https://github.com/erimeilis/dikduk/issues"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:analyze": "wrangler dev --var DICTABERT_ANALYZER_URL:http://127.0.0.1:8788/analyze",
    "analyzer:dictabert": "uv run --with transformers --with torch --with safetensors python scripts/dictabert-analyzer.py",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply pealim --local",
    "db:migrate:prod": "wrangler d1 migrations apply pealim --remote",
    "scrape:pealim": "tsx scripts/scrape-pealim.ts"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "node-html-parser": "^8.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "better-sqlite3": "^12.11.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
